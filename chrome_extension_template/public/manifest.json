{
  "manifest_version": 3,
  "version": "0.1.0",
  "name": "ORCID Works Manager",
  "description": "Import, batch-edit, deduplicate, merge, and export works on ORCID profiles",
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://orcid.org/*"],
      "js": ["content.js"]
    }
  ],
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Ctrl+B",
        "mac": "Command+B"
      },
      "description": "Opens Works Manager Popup",
      "global": true
    },
    "open_side_panel": {
      "suggested_key": {
        "default": "Ctrl+Shift+O",
        "mac": "Command+Shift+O"
      },
      "description": "Open Works Manager panel"
    }
  },
  "action": {
    "default_popup": "index.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "side_panel": {
    "default_path": "index.html"
  },
  "permissions": ["storage", "activeTab", "sidePanel", "commands", "identity"],
  "host_permissions": ["https://orcid.org/*", "https://pub.orcid.org/*"],
  "oauth2": {
    "client_id": "APP-PLACEHOLDER",
    "scopes": [
      "openid",
      "/activities/update"
    ]
  }
}
